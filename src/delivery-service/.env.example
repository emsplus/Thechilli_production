# ENV defaults to production (fail closed: no /docs, strict startup checks). Set development locally and in tests.
ENV=development
DATABASE_URL=postgresql+psycopg://pos:pos@localhost:5460/del_dev
# Root secret (>= 32 chars) for tenant service tokens and customer/rider/tracking links.
# Mint a tenant token: uv run python scripts/mint_token.py <restaurant_id>
LINK_SECRET=generate-a-long-random-string-at-least-32
PUBLIC_BASE_URL=http://localhost:8130
POS_BASE_URL=http://localhost:8000
# Only "mock" exists; production refuses it unless ALLOW_MOCK_PROVIDER=true.
WHATSAPP_PROVIDER=mock
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Restaurant rows store only the NAMES of these variables (must start with DEL_SECRET_).
DEL_SECRET_POS_WEBHOOK=
DEL_SECRET_POS_API_KEY=
# Token rotation (optional): "kid:secret,kid:secret", each secret >= 32 chars. LINK_ACTIVE_KID signs new tokens (default
# = first entry); removing a kid revokes everything it signed. LINK_SECRET alone still works (legacy kid "k0").
LINK_KEYRING=
LINK_ACTIVE_KID=

# Language flag (owner decision 2026-10-31: English only). 1 = Hindi catalogue on.
DELIVERY_ENABLE_LANGUAGES=0

# Public per-restaurant ordering link (docs/PUBLIC_ORDER_LINK.md): host of https://<host>/r/<slug> (empty = PUBLIC_BASE_URL) and the number of
# reverse proxies that append to X-Forwarded-For (0 = use the socket peer as the client IP).
PUBLIC_ORDER_BASE_URL=
TRUSTED_PROXY_HOPS=0
