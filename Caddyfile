	}
}

# API: pos-service at the root; platform-core and marketing-service only for the few routes browsers need (prefix stripped);
# payments-service only for provider webhooks.
{$ROUTER_SCHEME}://{$DOMAIN_API} {
	import tls_{$TLS_MODE_SUB}
	import common
	handle_path /platform/* {
		@onboarding path /api/v1/onboarding/applications /api/v1/onboarding/applications/* /api/v1/plans /api/v1/plans/*
		handle @onboarding {
			reverse_proxy platform-core:8000 {
		import up
	}
		}
		handle {
			respond "Not found" 404
		}
	}
	handle_path /marketing/* {
		@public path /api/v1/public/*
		handle @public {
			reverse_proxy marketing-service:8200 {
		import up
	}
		}
		handle {
			respond "Not found" 404
		}
	}
	handle_path /payments/* {
		@hooks {
			path /api/v1/webhooks/*
			not path /api/v1/webhooks/reprocess
		}
		handle @hooks {
			reverse_proxy payments-service:8000 {
		import up
	}
		}
		handle {
			respond "Not found" 404
		}
	}
	# F-06: machine-to-machine routes are never public. platform-core reaches pos-service's /internal/provision over the Docker
	# network; the provision key is still required, but the endpoint and its failure counters have no business on the internet.
	@internal path /internal /internal/*
	handle @internal {
		respond "Not found" 404
	}
	handle {
		reverse_proxy pos-service:8000 {
		import up
	}
	}
}

# Table QR codes (pos-service docs/TABLE_QR_REVIEWS.md): view-only menu /m/<token>, review form /rv/<token>, their static files,
# their JSON and the public menu photos go to pos-service; everything else stays with delivery-service.
{$ROUTER_SCHEME}://{$DOMAIN_ORDER} {
	import tls_{$TLS_MODE_SUB}
	import common
	@tableqr path /m/* /rv/* /qr-static/* /api/v1/table-qr/public/* /api/v1/media/menu/*
	handle @tableqr {
		reverse_proxy pos-service:8000 {
			import up
		}
	}
	handle {
		reverse_proxy delivery-service:8000 {
			import up
		}
	}
}
