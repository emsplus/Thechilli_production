# ENV defaults to "production" (fail closed). Local development must set ENV=development.
ENV=development
DATABASE_URL=postgresql+psycopg://pos:pos@localhost:5460/mkt_dev
# Required (unique, >= 32 chars) whenever ENV is not "development".
JWT_SECRET=generate-a-long-random-string
# Browser origins: the partner portal AND the public site (its sign-up page calls /public/invitations/validate and /redeem
# for partner invite links). Production: ["https://thechilli-marketing.zonov.ai","https://thechilli.zonov.ai"]
CORS_ORIGINS=["http://localhost:3200"]
INVITATION_TTL_HOURS=72
DEFAULT_COUNTRY_CODE=91
DEFAULT_CURRENCY=INR
# Outbound business-provisioning interface (see docs/DESIGN.md section 6). Empty URL = not configured (503 on provision).
PROVISIONING_BASE_URL=
PROVISIONING_SERVICE_KEY=
# Invitation delivery: mock (nothing is sent) or webhook (POST to your mail relay)
DELIVERY_PROVIDER=mock
DELIVERY_WEBHOOK_URL=
DELIVERY_WEBHOOK_TOKEN=
# Invitation links are {SIGNUP_BASE_URL}/signup?token=...: the PUBLIC SITE (web-public), e.g. https://thechilli.zonov.ai
SIGNUP_BASE_URL=http://localhost:3200
# Document upload
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_STORAGE_DIR=./var/documents
