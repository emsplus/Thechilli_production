# ENV defaults to production (fail closed: no /docs). Set development locally and in tests.
ENV=development
DATABASE_URL=postgresql+psycopg://pos:pos@localhost:5460/pay_dev
# HS256 secret (>= 32 bytes) used to verify the tenant-bound JWT (claims: tid, exp, aud=payments-service) that the
# calling service sends as `Authorization: Bearer <jwt>`. Empty/short = all routes 503. Later: JWKS.
JWT_SECRET=generate-a-long-random-string-of-at-least-32-bytes
RAZORPAY_BASE_URL=https://api.razorpay.com

# Provider credentials. provider-accounts rows store only the NAMES of these variables, which must live in the tenant's
# namespace PAY_SECRET_<TENANT>__<NAME> (tenant "rest-1" -> PAY_SECRET_REST_1__RZP_KEY_ID).
# Never commit real values; in production inject from your secret manager.
PAY_SECRET_REST_1__RZP_KEY_ID=
PAY_SECRET_REST_1__RZP_KEY_SECRET=
PAY_SECRET_REST_1__RZP_WEBHOOK=
