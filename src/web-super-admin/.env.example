# "mock" runs entirely without the backend (in-memory data, demo accounts). "live" proxies to platform-core.
HQ_API_MODE=mock
# Base URL of platform-core (server-side only; the browser never talks to it).
PLATFORM_CORE_URL=http://localhost:8400/api/v1
# Session cookie Secure flag. Defaults to true in production. Plain-http production-mode deployments must set this to false
# (and should only ever be on a trusted private network); otherwise sign-in fails with an explanatory error.
# HQ_COOKIE_SECURE=false
# Production refuses mock mode. Only for throwaway demos:
# HQ_ALLOW_MOCK_IN_PRODUCTION=true
