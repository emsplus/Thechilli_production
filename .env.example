# TheChilli.ai deployment settings. Copy to .env (cp .env.example .env && chmod 600 .env), fill the MUST lines, run ./deploy.sh.
# This is the ONE settings file of the stack. Database passwords, JWT keys, service keys, MFA keys and the PIN pepper are generated
# ON THE SERVER by deploy.sh (scripts/gen-env.sh) and appended to the same .env (mode 600); they are never in this example.
# Lines marked MUST are required; deploy.sh / scripts/check-env.sh refuse to start while they are empty or placeholders.

# ---------------------------------------------------------------- compose project (do not change on a running install)
COMPOSE_PROJECT_NAME=chilli

# ---------------------------------------------------------------- hostnames: the ONLY place they are written
# *.thechilli.zonov.ai (wildcard certificate) covers APP, WAITER, API, ORDER. SITE, ADMIN, PARTNER are separate names.
# public site + owner sign-up
DOMAIN_SITE=thechilli.zonov.ai
# Super Admin
DOMAIN_ADMIN=thechilli-admin.zonov.ai
# partner (marketing) portal
DOMAIN_PARTNER=thechilli-marketing.zonov.ai
# business app (owners, managers, cashiers)
DOMAIN_APP=app.thechilli.zonov.ai
# waiter PWA
DOMAIN_WAITER=waiter.thechilli.zonov.ai
# API (baked into the web images and the waiter app at build time)
DOMAIN_API=api.thechilli.zonov.ai
# customer order pages: routed, NOT announced yet (optional DNS record)
DOMAIN_ORDER=order.thechilli.zonov.ai
# Port suffix of the public URLs: empty in production (443). Only --local-test sets it (e.g. :8443).
PUBLIC_PORT_SUFFIX=

# ---------------------------------------------------------------- router / TLS
# Shared host (default): the host nginx terminates TLS and proxies to 127.0.0.1:STACK_HTTP_PORT (nginx/thechilli.conf).
# deploy.sh picks the first free port from 7080..7199 when this is empty or busy, and writes it here.
STACK_HTTP_PORT=7080
# Certificate files on the HOST for nginx/thechilli.conf (rendered by deploy.sh; the owner copies it into /etc/nginx/conf.d).
# The owner's certificate is ONE certificate listing all 7 names: SUB and TOP point at the same files. With a wildcard
# *.thechilli.zonov.ai certificate for app/waiter/api/order, put its paths in SUB and keep TOP for the three top names.
# MUST: *.thechilli.zonov.ai certificate (adjust path)
SSL_CERT_SUB=/etc/letsencrypt/live/thechilli.zonov.ai-wildcard/fullchain.pem
# MUST
SSL_KEY_SUB=/etc/letsencrypt/live/thechilli.zonov.ai-wildcard/privkey.pem
# MUST: thechilli / -admin / -marketing certificate
SSL_CERT_TOP=/etc/letsencrypt/live/thechilli.zonov.ai/fullchain.pem
# MUST
SSL_KEY_TOP=/etc/letsencrypt/live/thechilli.zonov.ai/privkey.pem
# Only with ./deploy.sh --own-tls (a host where nothing else uses 80/443): auto | files | internal
TLS_MODE_TOP=auto
TLS_MODE_SUB=auto
TLS_CERTS_DIR=./certs
# Private Docker subnets of this stack (change only if they clash with another network on the host: `docker network ls`).
DEFAULT_SUBNET=10.231.90.0/24
# dynamic addresses come only from this range; the fixed IPs below must be outside it
DEFAULT_IP_RANGE=10.231.90.128/25
PROXY_IP=10.231.90.10
POS_BFF_SUBNET=10.231.91.0/28
POS_BFF_IP_RANGE=10.231.91.0/29
POS_BFF_WEB_IP=10.231.91.10
POS_BFF_PROXY_IP=10.231.91.11

# ---------------------------------------------------------------- email (MUST: owner invites, receipts, reports, sign-up codes)
# MUST, e.g. smtp.zoho.in / smtp.gmail.com / email-smtp.ap-south-1.amazonaws.com
SMTP_HOST=
# 465 with ssl, 587 with starttls
SMTP_PORT=465
# ssl | starttls | none
SMTP_SECURITY=ssl
# MUST (mailbox login)
SMTP_USER=
# MUST (app password)
SMTP_PASSWORD=
# MUST: quoted, "Name <address>"
SMTP_FROM="Chilli Agent <no-reply@zonov.ai>"
# real = everyone gets mail (production). allowlist = only MAIL_ALLOWLIST_DOMAINS (+ SMTP_TEST_TO). log = nothing sent.
MAIL_POLICY=real
MAIL_ALLOWLIST_DOMAINS=zonov.ai
SMTP_TEST_TO=

# ---------------------------------------------------------------- optional providers (empty = feature stays off)
# voice from audio + Ask-AI. Empty: voice uses the local text parser, Ask-AI says it is not set up
GEMINI_API_KEY=
# e.g. gemini-3.8-flash (set together with the key)
GEMINI_MODEL=
# Razorpay (online payments). Webhook URL: https://<DOMAIN_API>/payments/api/v1/webhooks/razorpay/<account id>
RZP_KEY_ID=
RZP_KEY_SECRET=
RZP_WEBHOOK_SECRET=
# meta | empty (off)
WHATSAPP_PROVIDER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# AI providers (reserved names; the code that reads them may arrive in a later update: setting them early is harmless)
# AI_OCR_PROVIDER: auto | gemini | xai (invoice/bill scans). AI_STT_PROVIDER: auto | gemini | whisper (speech to text).
# AI_TEXT_PROVIDER: auto | gemini | xai (voice-parse fallback, recipe suggestions). Empty = auto (the code default):
# xAI scans when an xAI key is set, Whisper when OPENAI_API_KEY is set, Gemini otherwise. Check: README-DEPLOY.md "AI keys".
AI_OCR_PROVIDER=
AI_STT_PROVIDER=
# xAI (Grok) or any OpenAI-compatible vision API on the same path: either name works for the key.
# Live server: Groq = XAI_BASE_URL=https://api.groq.com/openai/v1, XAI_VISION_MODEL=qwen/qwen3.8-27b, XAI_API_KEY=<Groq key>
XAI_API_KEY=
GROK_API_KEY=
XAI_BASE_URL=
XAI_VISION_MODEL=
# OpenAI (Whisper speech to text)
OPENAI_API_KEY=
OPENAI_BASE_URL=
WHISPER_MODEL=
# empty = auto-detect; hi or en forces the language
WHISPER_LANGUAGE=
AI_TEXT_PROVIDER=
# empty = XAI_VISION_MODEL
XAI_TEXT_MODEL=

# ---------------------------------------------------------------- testing-phase voice wake samples (default off)
# true = the business app may send TEXT-ONLY wake-word samples (no audio; digits, e-mails and URLs stripped; kept 30 days; per
# restaurant) and fetch the wake variants learned for its own restaurant. For the owner's own testers only: MUST stay false (or unset)
# before real customers go live unless the privacy notice covers it. Off = POST /voice/wake-samples answers 404. Details:
# src/pos-service/docs/VOICE_WAKE_SAMPLES.md. After changing it: ./update.sh pos-service <zip> or recreate pos-service.
VOICE_SAMPLES_ENABLED=false

# ---------------------------------------------------------------- backups
# age public key (age1...) to encrypt backups; empty = plaintext backups in ./backups (mode 600, keep the host secure)
BACKUP_AGE_RECIPIENT=
