# TheChilli.ai internal router (caddy). Host-based routing; all names come from the DOMAIN_* environment variables.
# Default (shared host): ROUTER_SCHEME=http, TLS_MODE_*=none: plain HTTP inside the stack, published only on
# 127.0.0.1:${STACK_HTTP_PORT}; the host nginx terminates TLS and sets X-Forwarded-Proto/Host/For (nginx/thechilli.conf).
# Own host (docker-compose.tls.yml): ROUTER_SCHEME=https and TLS_MODE_TOP / TLS_MODE_SUB = auto (Let's Encrypt per host),
# files (/certs/<top|sub>/fullchain.pem + privkey.pem) or internal (local CA, tests).
{
	admin 127.0.0.1:2019
	servers {
		# X-Forwarded-* from the host nginx (reaches us through Docker's port publishing, i.e. a private address) are believed;
		# anything a browser sends is overwritten by the host nginx before it gets here.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

(tls_none) {
}
(tls_auto) {
}
(tls_internal) {
	tls internal
}
(tls_files_top) {
	tls /certs/top/fullchain.pem /certs/top/privkey.pem
}
(tls_files_sub) {
	tls /certs/sub/fullchain.pem /certs/sub/privkey.pem
}
(hsts_http) {
}
(hsts_https) {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
# Upstreams get ONE X-Forwarded-For value: the real client (taken from the host nginx's header, see trusted_proxies), so the
# APIs' rate limits and audit logs see the visitor, not Docker's gateway. They trust only this router's fixed IP.
(up) {
	header_up X-Forwarded-For {client_ip}
}
(common) {
	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	import hsts_{$ROUTER_SCHEME}
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	log {
		output stdout
		format json
		level INFO
	}
}

# Public site hostname: sign-up (web-public, Next.js) and the Razorpay webhook only; the website itself is the standalone stack deploy/site.
# Keep @signup in step with web-public's routes and assets (docs/testing/FINAL2_FRONTEND_REPORT.md).
{$ROUTER_SCHEME}://{$DOMAIN_SITE} {
	import tls_{$TLS_MODE_TOP}
	import common
	# Razorpay webhook of Chilli's own account (Chilli wallet recharge): the URL registered in the Razorpay dashboard is
	# https://<site host>/api/webhooks/razorpay/ ; it goes to platform-core's signed (HMAC) webhook, body untouched.
	@rzp_webhook {
		path /api/webhooks/razorpay /api/webhooks/razorpay/
		method POST
	}
	handle @rzp_webhook {
		rewrite * /api/v1/billing/webhooks/razorpay
		reverse_proxy platform-core:8000 {
			import up
		}
	}
	@signup path /signup /signup/* /_next/* /brand/*   # /terms, /privacy and /refund are pages of the standalone website
	handle @signup {
		reverse_proxy web-public:3000 {
			import up
		}
	}
	# Everything else is the ONE public website (its own stack, deploy/site): this router never serves it
	handle {
		redir {$MAIN_SITE_URL:https://thechilli.zonov.ai}{uri} 302
	}
}

# Super Admin (server-side proxy to platform-core; the browser never calls platform-core directly)
{$ROUTER_SCHEME}://{$DOMAIN_ADMIN} {
	import tls_{$TLS_MODE_TOP}
	import common
	reverse_proxy web-super-admin:3000 {
		import up
	}
}

# Partner portal (browser talks to its own BFF only)
{$ROUTER_SCHEME}://{$DOMAIN_PARTNER} {
	import tls_{$TLS_MODE_TOP}
	import common
	reverse_proxy web-marketing:3000 {
		import up
	}
}

# Business app
{$ROUTER_SCHEME}://{$DOMAIN_APP} {
