# ENV defaults to "production" (fail closed). Only the literal value "development" relaxes anything.
ENV=development
DATABASE_URL=postgresql+psycopg://pos:pos@localhost:5460/agg_dev
# Tenant callers: HS256 JWT in `Authorization: Bearer`, claims tid, exp, aud=JWT_AUDIENCE (iss if JWT_ISSUER set).
# Secrets must be >= 32 bytes; unset/short => 503 on every authenticated route in EVERY environment.
JWT_SECRET=
JWT_AUDIENCE=aggregator-service
JWT_ISSUER=
# Worker / platform-admin tokens (role=worker|admin, no tid), signed with a DIFFERENT secret.
INTERNAL_JWT_SECRET=
# Per-store webhook secrets and pos credentials are env var NAMES in the tenant's namespace, e.g.
#   AGG_SECRET_RESTO_1__ZOMATO_STORE_42=...   (webhook secret for one store; referenced by webhook_secret_ref)
#   AGG_SECRET_RESTO_1__POS_API_KEY=...       (service credential for pos-service, restaurant = tenant)
# The mock provider is for local development and tests ONLY. Refused unless ENV=development.
ENABLE_MOCK_PROVIDER=false
WEBHOOK_MAX_BODY_BYTES=262144
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_BAD_SIG_LIMIT=10
WEBHOOK_BAD_SIG_WINDOW_SECONDS=60
# pos-service (https required outside development)
POS_BASE_URL=
POS_TIMEOUT_SECONDS=10
# Outbound retry policy (seconds): delay = min(BASE * 2**(attempt-1), MAX)
OUTBOX_BACKOFF_BASE_SECONDS=5
OUTBOX_BACKOFF_MAX_SECONDS=3600
OUTBOX_MAX_ATTEMPTS=8
