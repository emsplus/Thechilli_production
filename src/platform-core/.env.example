# ENV defaults to production (fail closed): production refuses to start without a JWT keyring.
ENV=development
DATABASE_URL=postgresql+psycopg://pos:pos@localhost:5460/plat_dev
# RS256 keyring: JSON string or a file path (generate with: uv run python scripts/gen_keyring.py > keyring.json)
JWT_KEYRING_FILE=keyring.json
# JWT_KEYRING={"active_kid":"...","keys":[...]}
CORS_ORIGINS=["http://localhost:3200"]
# GST: rate is CONFIGURATION, not code. MUST BE VERIFIED BY A CA before production use.
GST_RATE_BPS=1800
GST_SAC_CODE=998314
SELLER_STATE_CODE=29
SELLER_GSTIN=
# Provisioning (docs/PROVISIONING.md): http (pos-service) or fake (in-memory)
PROVISIONER=http
# POS_SERVICE_URL=http://localhost:8000
# POS_PROVISION_KEY=            # plaintext; pos-service stores sha256 of it in PROVISION_KEY_SHA256
# OWNER_INVITE_URL_TEMPLATE=http://localhost:3010/accept-invite?token={token}
# MAILER=smtp
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
ONBOARDING_AUTO_APPROVE=false
# Env-configured machine callers (hash only). Example: python -c "import hashlib;print(hashlib.sha256(b'KEY').hexdigest())"
# SERVICE_KEYS={"marketing-service":{"key_sha256":"<hex>","scopes":["onboarding.submit","onboarding.read","subscriptions.read"]},"pos-service":{"key_sha256":"<hex>","scopes":["entitlements.read"]}}
# Reverse proxies whose X-Forwarded-For is trusted (IPs/CIDRs, comma separated). Empty = ignore the header.
# TRUSTED_PROXIES=10.0.0.0/8
# Staff MFA (TOTP). Roles listed must use MFA. Key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MFA_REQUIRED_ROLES=super_admin,finance
# MFA_ENCRYPTION_KEY=
# marketing-service read client (bearer token of a dedicated marketing_admin user)
# MARKETING_SERVICE_URL=http://localhost:8300/api/v1
# MARKETING_SERVICE_TOKEN=
