# Backend (apps/api) - never expose these to the frontend
ENV=development
DATABASE_URL=postgresql+psycopg://pos:pos@localhost:5460/pos
# DB role split (docs/PHASE1_PLAN.md PR 1; set up with scripts/setup_db_roles.py). With the split, DATABASE_URL is the
# pos_app login (no superuser, no BYPASSRLS, owns nothing) and migrations use the migrator login + owner role below.
# Leave both empty to keep the single-user setup (migrations then use DATABASE_URL).
# MIGRATION_DATABASE_URL=postgresql+psycopg://pos_migrator:<password>@localhost:5460/pos
# MIGRATION_ROLE=pos_owner
JWT_SECRET=generate-a-long-random-string
CORS_ORIGINS=["http://localhost:3100"]
GEMINI_API_KEY=
# India only, INR only (owner decision 2026-10-31; docs/INDIA.md): every restaurant is country IN, every amount is INR.
# There is no setting for it: the code and the database (CHECK constraints) accept nothing else.
# English only for now: emails and WhatsApp templates are always English. COMMS_ENABLE_LANGUAGES=1 allows Hindi when asked.
# COMMS_ENABLE_LANGUAGES=0
# TESTING-PHASE voice wake samples (docs/VOICE_WAKE_SAMPLES.md). true = the business app may send TEXT-ONLY wake-word samples
# (POST /voice/wake-samples, no audio, digits/e-mail/URLs stripped, kept 30 days) and fetch the variants learned for its own
# restaurant (GET /voice/wake-config). Default false (unset = off): the POST is a 404. MUST be off for real customers.
# VOICE_SAMPLES_ENABLED=false
# Frontend (apps/web) - public values only
NEXT_PUBLIC_API_BASE_URL=http://localhost:8110/api/v1

# Tenant provisioning by platform-core (docs/PROVISIONING.md). Only the SHA-256 of the key is configured here:
#   python -c "import hashlib,secrets;k=secrets.token_urlsafe(32);print(k, hashlib.sha256(k.encode()).hexdigest())"
# Give platform-core the key (POS_PROVISION_KEY) and put the hash here. Empty = /internal/provision/* is disabled (404).
# PROVISION_KEY_SHA256=
# PROVISION_IP_ALLOWLIST=
