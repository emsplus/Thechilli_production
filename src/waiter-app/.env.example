# Base URL of pos-service (the only backend this app talks to). No secrets belong in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8110/api/v1
# Poll interval for kitchen-ready notifications (ms). Replaced by a websocket later.
NEXT_PUBLIC_READY_POLL_MS=8000
# Menu snapshot older than this (hours) shows a stale-menu warning.
NEXT_PUBLIC_MENU_STALE_HOURS=12
